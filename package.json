{
  "name": "decklight",
  "version": "0.4.0",
  "description": "A presentation library designed to be authored by AI agents and humans alike: single-file decks, Keynote-style builds, theme-aware SVG diagrams, and truthful terminal recordings.",
  "type": "module",
  "main": "dist/decklight.js",
  "bin": {
    "decklight": "cli/decklight.mjs"
  },
  "files": [
    "cli/",
    "tools/",
    "dist/",
    "themes/",
    "docs/",
    "SPEC.md"
  ],
  "homepage": "https://decklight.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decklight/decklight.git"
  },
  "bugs": "https://github.com/decklight/decklight/issues",
  "keywords": [
    "presentation",
    "slides",
    "deck",
    "reveal",
    "keynote",
    "terminal",
    "asciicast",
    "tts",
    "ai",
    "agent"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepare": "npm run build",
    "test": "node test/run.mjs",
    "verify": "npm run build && node test/verify.mjs",
    "soak": "node test/soak.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "highlight.js": "^11.10.0",
    "temml": "^0.13.3"
  },
  "optionalDependencies": {
    "js-yaml": "^4.3.0",
    "node-pty": "^1.1.0",
    "sigstore": "^5.0.0"
  },
  "author": "Gilles Philippart <gilles.philippart@gmail.com>",
  "license": "Apache-2.0"
}
