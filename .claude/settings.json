{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-release-docs.sh\"",
            "if": "Bash(git push*)",
            "timeout": 60,
            "statusMessage": "checking docs before a release tag"
          }
        ]
      }
    ]
  }
}
