# No trailing slash. `node_modules/` matched a DIRECTORY only, so a symlink
# named node_modules — a worktree's link to the main checkout — was not
# ignored, and `git add -A` committed it (#435). Checking that link out later
# replaced the real node_modules with a link to itself. It left the tree again
# by accident (#439); this is what stops it coming back.
node_modules
.DS_Store
*.log
bundles/
demo/voiceover*/

# Build output. Derived from src/, so it is not versioned: the "prepare" script
# rebuilds it on npm install (contributors, git installs) and before npm
# publish/pack, and CI rebuilds it before both the npm release and the site
# deploy. It is still SHIPPED — package.json's "files" allowlist wins over this.
dist/

# Screenshots produced by tools/shot.mjs. Evidence, not source: CI publishes
# them to the orphan `shots` branch so a PR can show them inline.
.shots/

# Personal Claude Code config (permissions, model). The project hook and its
# settings ARE versioned — see .claude/settings.json.
.claude/settings.local.json

# The soak's receipt: which commit 'npm run soak' last passed on, written by
# test/soak.mjs and read by the pre-release hook. Evidence about one machine's
# run, not a fact about the repo — so it is per-clone and never committed.
.soak-pass.json
